server {
    listen 80;
    server_name ${DOMAIN};
    server_tokens off;
    location = /nginx-health { access_log off; return 200 "ok\n"; }
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        try_files $uri =404;
    }
    # Primeiro certificado: nao receber credenciais ou trafego de negocio por HTTP.
    location / { return 503; }
}
